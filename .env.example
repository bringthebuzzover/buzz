# Copy to `.env` and fill in from Firebase Console → Project settings → Your apps → Web app.
# Never commit `.env` (it is gitignored).

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=

# Base URL for the Buzz backend API (Stage 1+). Point at the local FastAPI
# dev server while iterating; the production value is set per-environment.
REACT_APP_API_URL=http://localhost:8000

# Strangler flag (Stage 4+). When "true", migrated slices (currently the org
# drop feed at /org/browse) render from the real API instead of the demo store.
# Leave "false" for the pure demo experience.
# NOTE: for a local API run, also set REFRESH_COOKIE_SECURE=false in the backend
# .env so the refresh cookie is sent over http://localhost.
REACT_APP_USE_API=false
