# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# The `pydantic-settings` loader in `app/config.py` reads this file at startup.

# Async SQLAlchemy URL. Prefer `postgresql+asyncpg://…`. Railway's injected
# `postgres://` / `postgresql://` URLs are rewritten to `+asyncpg` at startup.
DATABASE_URL=postgresql+asyncpg://localhost/buzz

# Symmetric secret used for JWT signing (Stage 3+). Generate a strong value
# for staging/production with `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
SECRET_KEY=dev-secret-change-me

# One of: development, staging, production
ENVIRONMENT=development

# --- JWT / session (architecture.md §5.3) ---
# Defaults are baked into app/config.py; override only to tune.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
OAUTH_STATE_TTL_MINUTES=10

# --- Refresh cookie ---
# Set REFRESH_COOKIE_SECURE=false for local HTTP dev so the cookie is sent.
#
# PRODUCTION CROSS-ORIGIN NOTE: SameSite=lax only sends the refresh/OAuth cookies
# when the SPA and API are same-site (e.g. both under buzz.com, or served behind
# one origin via an /api reverse proxy). If the SPA and API live on different
# registrable domains, the cookie is dropped and auth silently breaks. Deploy
# EITHER (a) same-origin: serve the API under the SPA's domain at /api (preferred),
# OR (b) cross-site: set REFRESH_COOKIE_SAMESITE=none + REFRESH_COOKIE_SECURE=true
# (HTTPS required) and ensure CORS allow_credentials + an exact-origin allowlist.
REFRESH_COOKIE_NAME=buzz_refresh
# Dev default false (sent over http://localhost). The startup validator rejects
# startup unless this is True off-dev, so staging/prod can't run insecure.
REFRESH_COOKIE_SECURE=false
# Must be "lax" for the Instagram OAuth redirect flow (see config.py); use "none"
# only for the cross-site deployment described above.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth
# Short-lived cookie that binds the OAuth state to the browser (CSRF).
OAUTH_STATE_COOKIE_NAME=buzz_oauth_state

# --- Instagram OAuth (architecture.md §3.4) ---
# Required for a LIVE OAuth run; tests use a fake client and need none of these.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:3000/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com

# --- Onboarding + email (architecture.md §3.4, §4) ---
# Base URL of the React SPA, used to build verification / setup links in emails.
FRONTEND_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_HOURS=24
BRAND_INVITE_TOKEN_TTL_DAYS=7
# Resend API key for transactional email; empty = dev/console logging only.
RESEND_API_KEY=
# When true, POST /api/brands/apply accepts public brand sign-ups. Set false to
# make brands admin-provisioned only (the route then returns 403).
BRAND_SELF_REGISTRATION_ENABLED=true

# --- Token encryption at rest (architecture.md §10.5 / §11.1) ---
# Fernet key (urlsafe base64, 32 bytes). MUST be overridden in staging/prod.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=Ja8bRSsk6Jv4KsqqOXS-1x6Ht6jj5WIztmsXkzXTnS4=
