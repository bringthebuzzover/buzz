# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# The `pydantic-settings` loader in `app/config.py` reads this file at startup.

# Async SQLAlchemy URL. Prefer `postgresql+asyncpg://…`. Railway's injected
# `postgres://` / `postgresql://` URLs are rewritten to `+asyncpg` at startup.
DATABASE_URL=postgresql+asyncpg://localhost/buzz

# Symmetric secret used for JWT signing (Stage 3+). HS256 wants ≥32 bytes
# (RFC 7518 §3.2). Generate a strong value for staging/production with
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
SECRET_KEY=dev-secret-change-me-not-for-production!!

# One of: development, staging, production
ENVIRONMENT=development

# --- JWT / session (buzz-ops engineering/architecture.md §5.3) ---
# Defaults are baked into app/config.py; override only to tune.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
OAUTH_STATE_TTL_MINUTES=10

# --- Refresh cookie ---
# Set REFRESH_COOKIE_SECURE=false for local HTTP dev so the cookie is sent.
#
# PRODUCTION CROSS-ORIGIN NOTE: SameSite=lax only sends the refresh/OAuth cookies
# when the SPA and API are same-site (e.g. both under buzz.com, or served behind
# one origin via an /api reverse proxy). If the SPA and API live on different
# registrable domains, the cookie is dropped and auth silently breaks. Deploy
# EITHER (a) same-origin: serve the API under the SPA's domain at /api (preferred),
# OR (b) cross-site: set REFRESH_COOKIE_SAMESITE=none + REFRESH_COOKIE_SECURE=true
# (HTTPS required) and ensure CORS allow_credentials + an exact-origin allowlist.
REFRESH_COOKIE_NAME=buzz_refresh
# Dev default false (sent over http://localhost). The startup validator rejects
# startup unless this is True off-dev, so staging/prod can't run insecure.
REFRESH_COOKIE_SECURE=false
# Must be "lax" for the Instagram OAuth redirect flow (see config.py); use "none"
# only for the cross-site deployment described above.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth
# Short-lived cookie that binds the OAuth state to the browser (CSRF).
OAUTH_STATE_COOKIE_NAME=buzz_oauth_state

# --- Instagram OAuth (buzz-ops engineering/architecture.md §3.4) ---
# Required for a LIVE OAuth run; tests use a fake client and need none of these.
# Copy real values from Meta (buzz-ops meta/app-setup.md §B). Never commit filled secrets.
# Local OAuth also needs this exact URI added in Meta §C (in addition to Railway):
#   http://localhost:3000/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
# Host only — do not append /v26.0 here.
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# Optional. Prefix for /me, /me/media, /{media-id}, and /{media-id}/insights.
# Default v26.0 matches Instagram API with Instagram Login get-started samples
# (Graph API current as of 2026-10-26). Empty keeps those calls unversioned.
# /access_token and /refresh_access_token stay on INSTAGRAM_GRAPH_BASE with no
# version (Meta's token references omit a version prefix).
INSTAGRAM_GRAPH_VERSION=v26.0

# Removed 2026-10-26 (do not re-add): FACEBOOK_GRAPH_BASE,
# INSTAGRAM_BUSINESS_DISCOVERY_TOKEN, INSTAGRAM_BUSINESS_DISCOVERY_IG_USER_ID.
# Apply does not call Meta. Delete those variables from Railway api if they
# are still set. Unknown env vars are ignored, so leaving them is a no-op.

# --- Onboarding + email (buzz-ops engineering/architecture.md §3.4, §4) ---
# Base URL of the React SPA, used to build verification / setup links in emails.
FRONTEND_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_HOURS=24
BRAND_INVITE_TOKEN_TTL_DAYS=7
ORG_CONNECT_TOKEN_TTL_DAYS=7
# Resend API key for transactional email; empty = dev/console logging only.
# From + public contact addresses live in backend/brand_emails.json (not env).
RESEND_API_KEY=
# Comma-separated exact addresses and/or @domain suffixes.
# Used only when EMAIL_FAIL_CLOSED=true. Empty + fail-closed suppresses
# every send. Both default off, so staging and production send as before.
EMAIL_ALLOWLIST=
EMAIL_FAIL_CLOSED=false
# Literal subject prefix, for example "[STAGING] " (include the trailing space).
# Empty leaves subjects unchanged. Not tied to ENVIRONMENT.
EMAIL_SUBJECT_PREFIX=
# One-off staging demo seed (scripts/seed_dev.py). Not a running-service setting.
# STAGING_SEED_CONFIRM=buzz-staging
# STAGING_DEMO_PASSWORD=
# PROD_DATABASE_HOSTS=
# Server-side Google Places Autocomplete (New) + Address Validation. Empty in
# development uses structured US format fallback (no billing). Required off-dev.
GOOGLE_ADDRESS_API_KEY=
# When true, POST /api/brands/apply accepts public brand sign-ups. Set false to
# make brands admin-provisioned only (the route then returns 403).
BRAND_SELF_REGISTRATION_ENABLED=true

# --- Token encryption at rest (buzz-ops engineering/architecture.md §10.5 / §11.1) ---
# Fernet key (urlsafe base64, 32 bytes). Leave empty in development — the API
# derives a local non-secret key (not committed as a Fernet string). MUST be
# set off-dev.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
