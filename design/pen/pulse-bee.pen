          "layoutPosition": "absolute",
          "x": 8,
          "y": 8
        }
      ],
      "theme": {
        "device": "mobile"
      }
    },
    {
      "type": "frame",
      "id": "PGDVQ",
      "x": 2190,
      "y": 0,
      "name": "Notes — motion & behaviour (not visible in a static frame)",
      "width": 640,
      "fill": "$white",
      "cornerRadius": 12,
      "layout": "vertical",
      "gap": 28,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "z0Uztr",
          "name": "Heading",
          "fill": "$ink",
          "content": "Notes: motion and behaviour",
          "fontFamily": "$font",
          "fontSize": "$type-h3",
          "fontWeight": "500",
          "letterSpacing": -0.57
        },
        {
          "type": "frame",
          "id": "LosLP",
          "name": "Note — Map bee loop",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "LwQv5",
              "name": "Title",
              "fill": "$ink",
              "content": "Map bee loop",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "rHxMh",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Route: Stanford → Rice → Duke → UPenn → Cornell → UChicago → Stanford. 10 s loop (1.5× the original 15 s): 7.6 s of paced flight on curved arcs plus a 400 ms dwell on each pin. The bee (26 px desktop, 24 px under 800 px map width, 17 px under 480 px) noses along the path and flaps (scaleY 1 → 0.93, 0.22 s). It drags a 9-dot ink comet trail; every dot renders at 34% opacity. On each dwell a 22 px yellow ring pulses out (scale 0.85 → 2.5, 0.4 s) and a black label pill with the campus name sits 14 px above the pin. The frames here show it mid-flight between Rice and Duke. With reduced motion the bee parks on Cornell with the ring and label.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "v6S5z",
          "name": "Note — Logo marquee",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "fMtfI",
              "name": "Title",
              "fill": "$ink",
              "content": "Logo marquee",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "a12rh",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One row of 23 grayscale school logos (48 px tall, 78% opacity, 56 px gap, 28 px side padding) drifting left on a 100 s loop. The frames show offset 0. With reduced motion it wraps into a centered grid.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "B46Hs",
          "name": "Note — How it works (pinned)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "pQWsn",
              "name": "Title",
              "fill": "$ink",
              "content": "How it works (pinned)",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "sQHSu",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The section is 4× the viewport tall (3600 px at 1440, 3376 px at 390) and pins the phone while the copy steps through Apply → Connect Instagram → Approved → Drop Feed, cross-fading each screen over 0.35 s. The pages show step 1; all four states are on the side board. The nav switches to its light tone over paper.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "Xuaop",
          "name": "Note — Stack cards",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "hbh07",
              "name": "Title",
              "fill": "$ink",
              "content": "Stack cards",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "p86lXZ",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Two 100vh image cards. As the second card scrolls over the first, the first shrinks (scale about 0.85) and tilts about -3°. The design collapses the pinned scroll space: the design page is 7412 px tall versus 10111 px live at 1440.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "uHQsh",
          "name": "Note — Hero",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "hIxhs",
              "name": "Title",
              "fill": "$ink",
              "content": "Hero",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "qp5aF",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A looping background video (still frame at t = 0 here). A shade fades the hero to ink as it scrolls away. On desktop the yellow bee flies near the top right of the hero; on mobile it is hidden.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "IyKgv",
          "name": "Note — Mobile dock",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "PFADg",
              "name": "Title",
              "fill": "$ink",
              "content": "Mobile dock",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "kpgrm",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Under 768 px a fixed bottom dock (ink at 92% with a 16 px blur) holds the yellow “Join as a student organization” pill on every viewport. It appears once in the mobile frame, at the bottom of the hero.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "wWvi0",
          "name": "Note — Current drops",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$space-2",
          "children": [
            {
              "type": "text",
              "id": "dZj5h",
              "name": "Title",
              "fill": "$ink",
              "content": "Current drops",
              "fontFamily": "$font",
              "fontSize": "$type-body",
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "nku3y",
              "name": "Body",
              "fill": "#0b0b0bb3",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The slides scroll horizontally; the prev arrow sits at 28% opacity on the first slide. The brand title is white or ink depending on how bright the image is (useTitleTone). The live code has NO hover scale on the cards. The hover board below is the requested variant only.",
              "lineHeight": 1.5,
              "fontFamily": "$font",
              "fontSize": "$type-small",
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
