# Copy to `.env` and fill in. Never commit `.env` (it is gitignored).

# Optional legacy Firebase keys (if still used by any path).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=

# Base URL for the Buzz backend API.
# Local: http://localhost:8000
# NOTE: for a local API run, also set REFRESH_COOKIE_SECURE=false in backend/.env
# so the refresh cookie is sent over http://localhost.
REACT_APP_API_URL=http://localhost:8000
